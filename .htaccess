
# .htaccess simplificado para Python/Passenger
Options -Indexes

# Bloquear acceso a archivos sensibles y ocultos (dotfiles)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Permitir acceso explícito a .htaccess si es necesario por el servidor (algunos lo requieren para leerlo)
<Files .htaccess>
  Require all denied
</Files>

